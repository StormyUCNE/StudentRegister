@page "/TiposPuntos/Index"
@inject TiposPuntosService tiposPuntosService
@rendermode InteractiveServer
@inject IToastService toastService
<PageTitle>Registro de Tipos Puntos</PageTitle>

<div class="container">
    <div class="card">
        <div class="card-header">
            <div class="card-title d-flex justify-content-between align-items-center">
                <h5>Registro de Tipos de Puntos</h5>
                <a href="/TiposPuntos/Create" class="btn btn-primary g-2">
                    <i class="bi bi-plus"></i>
                    <span>Crear</span>
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold">Buscar Por</label>
                    <select class="form-select" @bind="Filtro">
                        <option value="">Elija una Opción</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Valor Puntos">Valor Puntos</option>
                    </select>
                </div>
                <div class="col-12 col-md-8">
                    <label class="form-label fw-bold">Buscar</label>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar" @bind="ValorFiltro" />
                        <button type="button" class="bi bi-search btn btn-primary" @onclick="Buscar"></button>
                    </div>
                 
                </div>
            </div>

            <div class="table-responsive table-responsive-md">
                <table class="table mt-3 table-bordered table-hover table-responsive">
                    <thead>
                        <tr>
                            <th>TipoId</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>ValorPuntos</th>
                            <th>Color</th>
                            <th>Icono</th>
                            <th>Activo</th>
                            <th>Opción</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var p in ListaTipoPuntos)
                        {
                            <tr>
                                <td>@p.TipoId</td>
                                <td>@p.Nombre</td>
                                <td>@p.Descricion</td>
                                <td>@p.ValorPuntos</td>
                                <td style="color:@p.Color; font-weight:bold;">@p.Color</td>
                                <td class="d-flex justify-content-center align-items-center"><i class="@p.Icono"></i></td>
                                <td><span class="@(p.Activo ? "text-bg-primary p-2" : "text-bg-danger p-2")">@(p.Activo ? "Activado" : "Desactivado")</span></td>
                                <td>
                                    <a href="/TiposPuntos/Edit/@p.TipoId" class="btn btn-outline-primary btn-sm me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="card-footer">
                <label>Cantidad: @ListaTipoPuntos.Count()</label>
            </div>
        </div>
    </div>

</div>

@code {
    public List<TiposPuntos> ListaTipoPuntos = new List<TiposPuntos>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaTipoPuntos = await tiposPuntosService.Listar(p => p.TipoId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Nombre")
                ListaTipoPuntos = await tiposPuntosService.Listar(p => p.Nombre.ToLower().Contains(ValorFiltro.ToLower()));
            if (Filtro == "Valor Puntos")
            {
                if (int.TryParse(ValorFiltro, out int FiltroValorEntero))
                    ListaTipoPuntos = await tiposPuntosService.Listar(p => p.ValorPuntos == FiltroValorEntero);
                else
                    ListaTipoPuntos = await tiposPuntosService.Listar(p => p.TipoId > 0);
            }
        }
        else 
            ListaTipoPuntos = await tiposPuntosService.Listar(p => p.TipoId > 0);
    }
}