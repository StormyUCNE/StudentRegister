@page "/TiposPuntos/Create"
@inject TiposPuntosService tiposPuntosService
@rendermode InteractiveServer
@inject IToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Crear Tipo Punto</PageTitle>

<EditForm Model="TiposPuntos" OnValidSubmit="Guardar" >
    <DataAnnotationsValidator/>
    <div class="container">
        <div class="card">
            <div class="card-header">
                <div class="card-title m-auto d-flex justify-content-center align-items-center">
                    <label class="fs-4">Crear Tipo Punto</label>
                </div>
            </div>
           

            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="TiposPuntos.Nombre"></InputText>
                    <ValidationMessage For="()=> TiposPuntos.Nombre"/>
                </div>
                <div class="mb-2">
                    <label class="form-label">Decripción</label>
                    <InputText class="form-control" @bind-Value="TiposPuntos.Descricion"></InputText>
                    <ValidationMessage For="() => TiposPuntos.Descricion"/>
                </div>
                <div class="mb-2">
                    <label class="form-label">Valor Punto</label>
                    <InputNumber class="form-control" @bind-Value="TiposPuntos.ValorPuntos"></InputNumber>
                    <ValidationMessage For="() => TiposPuntos.ValorPuntos" />
                </div>
                <div class="mb-2 d-flex flex-column">
                    <label class="form-label">Color</label>
                    <InputText type="color" class="form-control-color" @bind-Value="TiposPuntos.Color"></InputText>
                    <ValidationMessage For="() => TiposPuntos.Color" />
                </div>
                <div class="mb-2 ">
                    <label class="form-label">Icono</label>
                    <InputSelect class="form-select" @bind-Value="TiposPuntos.Icono">
                        <option value="">Seleccione</option>
                        <option value="bi bi-star">Estrella</option>
                        <option value="bi bi-trophy">Trofeo</option>
                        <option value="bi bi-award">Medalla</option>
                    </InputSelect>
                    <ValidationMessage For="() => TiposPuntos.Icono" />
                </div>
                <div class="mb-2 ">
                    <label class="form-label">Activo</label>
                    <InputSelect class="form-select" TValue="bool" @bind-Value="TiposPuntos.Activo">
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                    </InputSelect>
                    <ValidationMessage For="() => TiposPuntos.Activo" />
                </div>
            </div>

            <div class="card-footer text-center mt-2 d-flex justify-content-center g-3">
                <a href="/TiposPuntos/Index" class="btn btn-secondary d-flex align-items-center gap-2 me-3">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>
                </a>

                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="bi bi-floppy"></i>
                    <span>Guardar</span>
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public TiposPuntos TiposPuntos = new TiposPuntos();

    private async Task Guardar(){
        if (await tiposPuntosService.ExisteDuplicado(TiposPuntos)){
            toastService.ShowError("El Tipo de Punto ya Existe, No se Admiten Duplicados");
            return;
        }
        var creado = await tiposPuntosService.Guardar(TiposPuntos);
        if (creado)
        {
            toastService.ShowSuccess("Tipo de Punto Guardado Correctamente");
            navigationManager.NavigateTo("/TiposPuntos/Index");
        }
        else
        {
            toastService.ShowError("No se Pudo Guardar el Tipo de Punto Correctamente");
            navigationManager.NavigateTo("/TiposPuntos/Index");
        }
    }
}