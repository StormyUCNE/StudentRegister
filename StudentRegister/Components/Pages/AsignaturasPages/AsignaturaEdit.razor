@page "/Asignatura/Edit/{AsignaturaId: int}"
@inject AsignaturasService asignaturasService
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject IToastService toastService

<PageTitle>Editar</PageTitle>
<EditForm Model="Asignatura" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Estudiante</h5>
            </div>

            <div class="card-body">

                @*AsignaturaId*@
                <div class="mb-3">
                    <label class="form-label"><strong>AsignaturaId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Asignatura.AsignaturaId" readonly></InputNumber>
                </div>

                @*Codigo Asignatura*@
                <div class="mb-3">
                    <label class="form-label"><strong>Código</strong></label>
                    <InputNumber class="form-control" @bind-Value="Asignatura.Codigo"></InputNumber>
                    <ValidationMessage For="(() => Asignatura.Codigo)" />
                </div>

                @*Nombre*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombre</strong></label>
                    <InputText class="form-control" @bind-Value="Asignatura.Nombre"></InputText>
                    <ValidationMessage For="(() => Asignatura.Nombre)" />
                </div>

                @*Aula*@
                <div class="mb-3">
                    <label class="form-label"><strong>Aula</strong></label>
                    <InputText class="form-control" @bind-Value="Asignatura.Aula"></InputText>
                    <ValidationMessage For="(() => Asignatura.Aula)" />
                </div>

                @*Créditos*@
                <div class="mb-3">
                    <label class="form-label"><strong>Créditos</strong></label>
                    <InputNumber class="form-control" @bind-Value="Asignatura.Credito"></InputNumber>
                    <ValidationMessage For="(() => Asignatura.Credito)" />
                </div>
            </div>
            <div class="card-footer text-center mt-2 d-flex justify-content-center gap-3">
                <a href="/Estudiante/Index" class="btn btn-secondary"><span class="bi bi-arrow-left">Volver</span></a>
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="Eliminar">
                    <i class="bi bi-trash"></i>
                    Eliminar
                </button>
                <button type="submit" class="btn btn-primary d-flex justify-content-center align-items-center gap-2"><i class="bi bi-floppy"></i><span>Guardar</span></button>
            </div>
        </div>
    </div>

</EditForm>
@code {
    [Parameter]
    public int AsignaturaId { get; set; }

    public Asignaturas Asignatura { get; set; } = new Asignaturas();

    protected override async Task OnInitializedAsync()
    {
        Asignatura = await asignaturasService.Buscar(AsignaturaId);
    }

    private async Task Modificar()
    {
        if (await asignaturasService.ExisteDuplicado(Asignatura))
        {
            toastService.ShowError("La Asignatura ya Existe, No se Admiten Duplicados");
            return;
        }
        var creado = await asignaturasService.Guardar(Asignatura);
        if (creado)
        {
            toastService.ShowSuccess("Asignatura Modificada Correctamente");
            navigationManager.NavigateTo("/Asignatura/Index");
        }
        else
        {
            toastService.ShowError("Asignatura No Pudo Ser Modificada Correctamente");
            navigationManager.NavigateTo("/Asignatura/Index");
        }
    }
    private async Task Eliminar()
    {
        var eliminado = await asignaturasService.Eliminar(Asignatura.AsignaturaId);

        if (eliminado)
        {
            toastService.ShowSuccess("Asignatura Eliminada Correctamente");
            navigationManager.NavigateTo("/Asignatura/Index");
        }
        else
        {
            toastService.ShowError("Asignatura No Pudo Ser Eliminada Correctamente");
        }
    }
}