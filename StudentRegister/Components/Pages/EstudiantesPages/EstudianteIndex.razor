@page "/Estudiante/Index"
@inject NavigationManager navigationManager
@inject EstudiantesService estudiantesService
@rendermode InteractiveServer

<PageTitle>Registro de Estudiantes</PageTitle>
<div class="container">
    <div class="card shadow-lg ">
        <div class="card-header d-flex gap-3 justify-content-between align-items-center">
            <h5 class="card-title">Registro de Estudiantes</h5>
            <a href="/Estudiante/Create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-square"></i>
                <span>Crear</span>
            </a>
        </div>

        <div class="card-body">
            @* labels *@
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Filtrar por</label>
                </div>

                <div class="col-md-8">
                    <label class="form-label">Búsqueda</label>
                </div>
            </div>
            @*Inputs y Botones*@
            <div class="row align-items-center">

                <div class="col-md-4">
                    <select class="form-select" @bind="Filtro">
                        <option value="">Elija una opción</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Email">Email</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar" @bind="ValorFiltro">
                        <button type="button" class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Tabla-->
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>EstudianteId</th>
                        <th>Nombres</th>
                        <th>Email</th>
                        <th>Edad</th>
                        <th>Opciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var e in ListaEstudiantes)
                    {
                        <tr>
                            <td>@e.EstudianteId</td>
                            <td>@e.Nombres</td>
                            <td>@e.Email</td>
                            <th>@e.Edad</th>
                            <td>
                                <a href="/Estudiante/Edit/@e.EstudianteId" class="btn btn-outline-primary btn-sm me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <label>Cantidad: @ListaEstudiantes.Count()</label>
        </div>
    </div>

</div>
@code {
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
    }

    private async Task Buscar()
    {
        if(ValorFiltro.Trim() != "")
        {
            if (Filtro == "Nombre")
                ListaEstudiantes = await estudiantesService.Listar(e => e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            else if (Filtro == "Email")
                ListaEstudiantes = await estudiantesService.Listar(e => e.Email.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else
            ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
    }
}